<?xml version="1.0" encoding="utf-8"?>
<!-- Latar jendela saat aplikasi diluncurkan.

     Harus OPAK dan berwarna sama dengan latar Flutter (#08080C). Kalau
     transparan atau putih, akan terlihat kedipan — atau wallpaper HP
     menembus — sebelum Flutter menggambar frame pertamanya. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/latar_peluncur" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
