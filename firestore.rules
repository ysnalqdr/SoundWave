rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userDoc().role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return signedIn() && userDoc().role == 'super_admin';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ===== USERS =====
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Registration: only own doc, role must be buyer
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email;

      // Self-update: cannot change role / email / createdAt
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['role', 'email', 'createdAt']);

      // Super admin may change roles (and other fields) on other users; cannot modify own role
      allow update: if isSuperAdmin()
        && (request.auth.uid != userId || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        && (request.resource.data.role in ['user', 'admin', 'super_admin']);

      // Only super_admin may delete user documents; cannot delete own account or another super_admin
      allow delete: if isSuperAdmin()
        && request.auth.uid != userId
        && resource.data.role != 'super_admin';

      // ===== CLAIMED PROMOS (voucher yang diklaim user) =====
      match /claimed_promos/{promoId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId);
      }
    }

    // ===== EVENTS =====
    //
    // Katalog konser terbuka untuk siapa saja — pengunjung harus bisa melihat
    // daftar konser dan harga **sebelum** login, sama seperti toko tiket mana
    // pun. Dokumen `_backend_config` yang dulu menumpang di sini sudah
    // dipindah ke `app_config/backend` (Okt 2026), jadi koleksi ini kini
    // murni data bisnis.
    //
    // Kenapa TIDAK memakai syarat per-dokumen di sini: aturan seperti
    //   allow read: if eventId != '_backend_config' || signedIn();
    // membuat Firestore menolak **seluruh query koleksi** dengan
    // `permission-denied`, karena engine aturan tidak bisa membuktikan
    // syarat itu berlaku untuk setiap dokumen yang mungkin ikut terambil.
    // Itulah yang dulu membuat layar Jelajah, Kelola Konser, dan Laporan
    // gagal total padahal tulisannya berhasil.
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== TICKETS =====
    //
    // CATATAN PENTING (audit Okt 2026): dokumen `tickets` adalah **katalog
    // harga & stok**, bukan tiket milik orang. Isinya: idKonser, kategori,
    // harga, stok, terjual. Tidak ada nama, email, atau kode booking di sini —
    // data pribadi ada di `orders`. Karena itu `allow read: if true` di sini
    // BUKAN kebocoran data pribadi: katalog harga memang harus bisa dilihat
    // pengunjung sebelum login, dan itu praktik normal toko tiket.
    //
    // Yang perlu dijaga bukan bacanya, tapi **tulisnya**: stok hanya boleh
    // berubah lewat Cloud Functions (Admin SDK, memakai transaksi). Klien
    // tidak boleh menulis. Komentar lama di sini sudah benar soal itu.
    match /tickets/{ticketId} {
      allow read: if true;
      // Stock mutations after payment happen via Admin SDK (Cloud Functions)
      allow create, update, delete: if isAdmin();
    }

    // ===== ORDERS =====
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      // Buyer creates PENDING order only; cannot self-set PAID/AKTIF
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.keys().hasAll([
             'kodeBooking', 'idKonser', 'judulKonser', 'kategoriTiket',
             'jumlahTiket', 'totalHarga', 'tanggalBeli', 'userId', 'status'
           ]);

      // Buyer may cancel own PENDING order only
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'PENDING'
        && request.resource.data.status == 'CANCELLED'
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'updatedAt']);

      // Admin gate scan / management
      allow update, delete: if isAdmin();
    }

    // ===== FAVORITES =====
    match /favorites/{favId} {
      allow read: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'eventId']);

      allow update: if false;

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ===== REVIEWS =====
    //
    // Dulu `allow read: if true` — siapa pun, tanpa login, bisa mengunduh
    // seluruh ulasan beserta userId penulisnya. Ulasan baru berguna di halaman
    // detail konser, dan halaman itu hanya dibuka pembeli, jadi tidak ada
    // alasan membukanya untuk publik.
    match /reviews/{reviewId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow delete: if isAdmin();
    }

    // ===== GATE SCANS (Offline sync ledger) =====
    match /gate_scans/{scanId} {
      allow read, write: if isAdmin();
    }

    // ===== APP CONFIG =====
    //
    // Berisi `backend/` — alamat tunnel backend yang dibaca aplikasi saat
    // checkout. **Sengaja tetap publik**: yang tersimpan hanya alamat URL,
    // bukan kredensial, dan aplikasi perlu membacanya sebelum sesi login
    // sepenuhnya siap. Menulis hanya lewat Admin SDK.
    match /app_config/{configId} {
      allow read: if true;
      allow write: if false; // Admin SDK only
    }

    // ===== ANALYTICS (Admin SDK / Functions only) =====
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===== PROMO CODES =====
    match /promo_codes/{promoId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ===== REFUNDS =====
    //
    // Ini **bukan** permintaan refund (tidak ada alur itu di aplikasi).
    // Ini **audit trail keputusan admin**: ditulis saat admin menekan
    // "Setujui" / "Tolak". Karena itu `create` hanya untuk admin.
    //
    // Sebelumnya `create` terbuka untuk pembeli mana pun, dan
    // `request.resource.data` tidak divalidasi sama sekali. Artinya siapa pun
    // yang login bisa membuat dokumen refund palsu dengan
    // `status: 'APPROVED'` dan `refundAmount` berapa saja. Admin melihatnya
    // di layar Kelola Refund dan mengira itu permintaan sungguhan.
    match /refunds/{refundId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin()
        && request.resource.data.status in ['PENDING', 'APPROVED', 'REJECTED']
        && request.resource.data.totalHarga is number
        && request.resource.data.totalHarga >= 0
        && request.resource.data.jumlahTiket is int
        && request.resource.data.jumlahTiket > 0
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0;

      allow update: if isAdmin();
      allow delete: if false;
    }


    // ===== NOTIFICATIONS (user read own) =====
    match /notifications/{notifId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ===== PROMO BANNERS =====
    //
    // Banner promo hanya tampil di dalam aplikasi setelah login, jadi tidak
    // perlu bisa diunduh publik.
    match /promo_banners/{bannerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
